@echo off
title Colibri sensor info - send (read only)
echo Collecting minion and camera info and sending it to Claude. About a minute; changes nothing...
powershell -NoProfile -ExecutionPolicy Bypass -Command "[Net.ServicePointManager]::SecurityProtocol='Tls12'; $k='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImplZG9sbmtqbWxycnVpcGtncXlkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA3ODk1ODQsImV4cCI6MjEwNjM2NTU4NH0.h3W7vimHuA_KPGmOjGN8HhM24k9apRta44l9D8xtF-Y'; $now=(Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ'); $t=''; try { $z=Join-Path $env:TEMP 'colibri-info.zip'; $d=Join-Path $env:TEMP 'colibri-info'; Invoke-WebRequest 'https://tangerine-smakager-bdebcf.netlify.app/downloads/Colibri-minion-info.zip' -OutFile $z -UseBasicParsing -ErrorAction Stop; Expand-Archive $z $d -Force -ErrorAction Stop; try { & (Join-Path $d 'colibri-minion-info.ps1') } catch { $t += 'COLLECTOR ERROR: ' + $_.Exception.Message + [Environment]::NewLine }; $f=Get-ChildItem $d -Filter 'minion-info-*.txt' | Sort-Object LastWriteTime | Select-Object -Last 1; if ($f) { $t += [IO.File]::ReadAllText($f.FullName) } else { $t += 'NO OUTPUT FILE' } } catch { $t += 'SETUP ERROR: ' + $_.Exception.Message }; try { $row=@{kind='colibri_diag'; id=($env:COMPUTERNAME+'|'+$now); data=@{pc=$env:COMPUTERNAME; at=$now; text=$t}; deleted=$false; updated_at=$now}; $body=ConvertTo-Json -InputObject @($row) -Depth 4 -Compress; Invoke-RestMethod -Method Post -Uri 'https://jedolnkjmlrruipkgqyd.supabase.co/rest/v1/fleet_records' -Headers @{apikey=$k; Authorization=('Bearer '+$k); Prefer='return=minimal'} -ContentType 'application/json; charset=utf-8' -Body ([Text.Encoding]::UTF8.GetBytes($body)) -ErrorAction Stop | Out-Null; Write-Host 'Sent to Claude. You can close this window.' -ForegroundColor Green } catch { Write-Host ('FAILED to send: ' + $_.Exception.Message) -ForegroundColor Red }"
echo.
pause
